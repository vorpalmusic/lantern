# pathfinder creates global variables for all relevant paths and is then sourced by all scripts
# lib/pathfinder
# author: J4CKD4W

### FIRST, DISCOVER THE LANTERN TOOL AND GRAB ITS DIRECTORY AS ROOTDIR
MYBIN="$(command -v lantern 2>/dev/null || true)"
ROOTDIR="$(cd -- "$(dirname -- "$(readlink -f -- "$MYBIN")")" >/dev/null 2>&1 && pwd)"
. "$ROOTDIR/.config"

### Resolve helper directories relative to this script, works via symlink
LIBDIR="$ROOTDIR/lib"
MODDIR="$ROOTDIR/modules"
LISTDIR="$ROOTDIR/lists"
SCRIPTDIR="$ROOTDIR/scripts"
BINDIR="$ROOTDIR/bin"
CONFIG="$ROOTDIR/.config"
REQSDIR="$LISTDIR/reqs"

### Resolve local output directories, defaulting to the current working dir if not set in .config
BASEDIR="$(cd -- "$OUTFOLDER" 2>/dev/null && pwd -P)" || BASEDIR="$(pwd -P)"
