### predefined nmap scan types for lantern
### lib/nmapper
### author: J4CKD4W

# expects:
#   - pathfinder already sourced (ROOTDIR, BASEDIR, etc.)
#   - messages already sourced (info/fail/header/follow/tab)
#   - TARGET set/exported by lantern


NMAPDIR="$OUTDIR/nmap"
mkdir -p -- $NMAPDIR

nmap-disc() {
  local part1 part2 part3 pid1 pid2 pid3 discovered summary

  printf '\n'
  info "${CYAN}Rapid nmap port discovery on: ${BLUE}${TARGET}...${END}"

  discmap="$NMAPDIR/disc.gnmap"
  part1="$NMAPDIR/ports.p1"
  part2="$NMAPDIR/ports.p2"
  part3="$NMAPDIR/ports.p3"

  rm -f "$discmap" "$part1" "$part2" "$part3"

  sudo nmap -p1-22000 --open -sS -n -Pn --min-rate 2500 \
    --max-retries 1 -T3 -oG "$part1" "$TARGET" >/dev/null 2>&1 &
  pid1=$!

  sudo nmap -p22001-44000 --open -sS -n -Pn --min-rate 2500 \
    --max-retries 1 -T3 -oG "$part2" "$TARGET" >/dev/null 2>&1 &
  pid2=$!

  sudo nmap -p44001-65535 --open -sS -n -Pn --min-rate 2500 \
    --max-retries 1 -T3 -oG "$part3" "$TARGET" >/dev/null 2>&1 &
  pid3=$!

  ## check for failures of the scans
  rc=0

  wait "$pid1"; s1=$?
  wait "$pid2"; s2=$?
  wait "$pid3"; s3=$?

  [ $s1 -eq 0 ] || { warn "$(tab 2)" "Discovery scan failed: ports 1-22000 (rc=$s1)"; rc=1; }
  [ $s2 -eq 0 ] || { warn "$(tab 2)" "Discovery scan failed: ports 22001-44000 (rc=$s2)"; rc=1; }
  [ $s3 -eq 0 ] || { warn "$(tab 2)" "Discovery scan failed: ports 44001-65535 (rc=$s3)"; rc=1; }

  ## aggregate discovered ports
  : > "$discmap"
  [ -f "$part1" ] && cat "$part1" >> "$discmap"
  [ -f "$part2" ] && cat "$part2" >> "$discmap"
  [ -f "$part3" ] && cat "$part3" >> "$discmap"
  rm -f "$part1" "$part2" "$part3"

  discovered="$(grep -oP '\d{1,5}/open' "$discmap" 2>/dev/null \
                | cut -d'/' -f1 | sort -n -u || true)"

  if [ -z "$discovered" ]; then
    fail "$(tab 1)" "No open ports discovered."
    PORTS=""
    return 2
  fi

  summary="$(echo "$discovered" | tr '\n' ',' | sed 's/,$//')"
  info "$(tab 1)" "${PURPLE}Open ports discovered: ${BLUE}${summary}${END}"

  PORTS="$(echo "$discovered" | xargs | tr ' ' ',')"
  return 0
}

nmap-targeted() {
  local chunk=20          # ports per scan
  local max_bg=2          # max concurrent targeted http-validate jobs

  local tdir listfile total start end chunkports outfile rc
  local -a ports pids
  local nscans done idx

  tdir="$NMAPDIR/targeted"
  listfile="$tdir/list"
  mkdir -p -- "$tdir" || return 2
  : > "$listfile"

  if [ -z "${PORTS:-}" ]; then
    fail "$(tab 1)" "No open ports detected; skipping targeted scan."
    return 2
  fi

  header "Targeted scanning on discovered ports (${chunk} ports/scan)..."
  follow "$(tab 2)" "As scans finish, we harvest HTTP candidates and feed http-validate."

  IFS=',' read -r -a ports <<< "$PORTS"
  total="${#ports[@]}"
  [ "$total" -gt 0 ] || { fail "$(tab 1)" "No ports to scan."; return 2; }

  nscans=$(( (total + chunk - 1) / chunk ))
  done=0

  _progress() {
    local d="$1" t="$2"
    local pct=0
    [ "$t" -gt 0 ] && pct=$(( (d * 100 + t/2) / t ))  # rounded
    info "$(tab 1)" "${PURPLE}scan progress:${END} ${BLUE}${d}/${t} (${pct}%)${END}"
  }

  for ((idx=0; idx<nscans; idx++)); do
    start=$(( idx * chunk ))
    end=$(( start + chunk ))
    [ "$end" -gt "$total" ] && end="$total"

    # build CSV port list for this scan
    chunkports=""
    local j
    for ((j=start; j<end; j++)); do
      if [ -n "$chunkports" ]; then
        chunkports+=",${ports[$j]}"
      else
        chunkports="${ports[$j]}"
      fi
    done

    outfile="$(printf '%s/targeted-%03d.xml' "$tdir" $((idx+1)) )"

    # record this scan artifact in the list file (data file write)
    printf '%s\n' "$outfile" >> "$listfile"

    # run targeted nmap for this scan
    sudo nmap -sCV -p"$chunkports" -n -Pn --max-retries 2 "$TARGET" \
      -oX "$outfile" >/dev/null 2>&1
    rc=$?

    done=$((done + 1))
    _progress "$done" "$nscans"

    if [ $rc -ne 0 ]; then
      warn "$(tab 2)" "Targeted scan failed (rc=$rc): ports $chunkports"
      continue
    fi

    # ---- harvest HTTP candidate ports from this scan into a data file ----
    local harv nfound
    harv="$(printf '%s/harvested-%03d.ports' "$tdir" $((idx+1)) )"

    # write/update harvest file (data file write)
    targ-http-ports "$outfile" | awk '/^[0-9]+$/' | sort -n -u > "$harv" || true
    nfound="$(wc -l < "$harv" 2>/dev/null || echo 0)"
    info "$(tab 1)" "${PURPLE}data: ${BLUE}wrote ${GREEN}${nfound} entries ${PURPLE}-> ${BLUE}$(basename "$harv")${END}"

    if [ "$nfound" -eq 0 ]; then
      info "$(tab 2)" "${PURPLE}http-harvest: ${BLUE}no HTTP candidates in scan $((idx+1))${END}"
      continue
    fi

    # throttle background validations
    while [ "${#pids[@]}" -ge "$max_bg" ]; do
      wait "${pids[0]}" 2>/dev/null || true
      pids=("${pids[@]:1}")
    done

    # validate harvested ports (targeted mode) quietly (http-validate itself appends to httptarg.tsv)
    (
      export HTTPMODE=targeted
      cat "$harv" | "$MODDIR/http/http-validate" >/dev/null 2>&1
    ) &
    pids+=("$!")
  done

  # wait for remaining http-validate jobs
  local pid
  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done

  TARGETEDXML="$tdir"
  export TARGETEDXML
  return 0
}
