### predefined nmap scan types for lantern
### lib/nmapper
### author: J4CKD4W

# expects:
#   - pathfinder already sourced (ROOTDIR, BASEDIR, etc.)
#   - messages already sourced (info/fail/header/follow/tab)
#   - TARGET set/exported by lantern


NMAPDIR="$OUTDIR/nmap"
mkdir -p $NMAPDIR

nmap-disc() {
  local part1 part2 part3 pid1 pid2 pid3 discovered summary

  printf '\n'
  info "${CYAN}Rapid nmap port discovery on: ${BLUE}${TARGET}...${END}"

  discmap="$NMAPDIR/disc.gnmap"
  part1="$NMAPDIR/ports.p1"
  part2="$NMAPDIR/ports.p2"
  part3="$NMAPDIR/ports.p3"

  rm -f "$discmap" "$part1" "$part2" "$part3"

  sudo nmap -p1-22000 --open -sS -n -Pn --min-rate 2500 \
    --max-retries 1 -T3 -oG "$part1" "$TARGET" >/dev/null 2>&1 &
  pid1=$!

  sudo nmap -p22001-44000 --open -sS -n -Pn --min-rate 2500 \
    --max-retries 1 -T3 -oG "$part2" "$TARGET" >/dev/null 2>&1 &
  pid2=$!

  sudo nmap -p44001-65535 --open -sS -n -Pn --min-rate 2500 \
    --max-retries 1 -T3 -oG "$part3" "$TARGET" >/dev/null 2>&1 &
  pid3=$!

  ## check for failures of the scans
  rc=0

  wait "$pid1"; s1=$?
  wait "$pid2"; s2=$?
  wait "$pid3"; s3=$?

  [ $s1 -eq 0 ] || { warn "$(tab 2)" "Discovery scan failed: ports 1-22000 (rc=$s1)"; rc=1; }
  [ $s2 -eq 0 ] || { warn "$(tab 2)" "Discovery scan failed: ports 22001-44000 (rc=$s2)"; rc=1; }
  [ $s3 -eq 0 ] || { warn "$(tab 2)" "Discovery scan failed: ports 44001-65535 (rc=$s3)"; rc=1; }

  ## aggregate discovered ports
  : > "$discmap"
  [ -f "$part1" ] && cat "$part1" >> "$discmap"
  [ -f "$part2" ] && cat "$part2" >> "$discmap"
  [ -f "$part3" ] && cat "$part3" >> "$discmap"
  rm -f "$part1" "$part2" "$part3"

  discovered="$(grep -oP '\d{1,5}/open' "$discmap" 2>/dev/null \
                | cut -d'/' -f1 | sort -n -u || true)"

  if [ -z "$discovered" ]; then
    fail "$(tab 2)" "No open ports discovered."
    PORTS=""
    return 2
  fi

  summary="$(echo "$discovered" | tr '\n' ',' | sed 's/,$//')"
  info "$(tab 2)" "${PURPLE}Open ports discovered: ${BLUE}${summary}${END}"

  PORTS="$(echo "$discovered" | xargs | tr ' ' ',')"
  return 0
}

nmap-targeted() {
  TARGETEDXML="$NMAPDIR/targeted.xml"

  if [ -z "${PORTS:-}" ]; then
    fail "$(tab 1)" "No open ports detected; skipping targeted scan."
    return 2
  fi

  header "Targeted scanning on discovered ports... if there are many, this could take a while..."
  follow "$(tab 2)" "Results will populate the web report."

  sudo nmap -sCV -p"$PORTS" -n -Pn --max-retries 2 --host-timeout 120s "$TARGET" \
    -oX "$TARGETEDXML" >/dev/null 2>&1

  return $?
}
