### predefined nmap scan types for lantern
### lib/nmapper
### author: J4CKD4W

# expects:
#   - pathfinder already sourced (ROOTDIR, BASEDIR, etc.)
#   - messages already sourced (info/fail/header/follow/tab)
#   - TARGET set/exported by lantern


NMAPDIR="$OUTDIR/nmap"
mkdir -p $NMAPDIR

nmap-disc() {
  local part1 part2 part3 pid1 pid2 pid3 discovered summary

  printf '\n'
  info "${CYAN}Rapid nmap port discovery on: ${BLUE}${TARGET}...${END}"

  discmap="$NMAPDIR/disc.gnmap"
  part1="$NMAPDIR/ports.p1"
  part2="$NMAPDIR/ports.p2"
  part3="$NMAPDIR/ports.p3"

  rm -f "$discmap" "$part1" "$part2" "$part3"

  sudo nmap -p1-22000 --open -sS -n -Pn --min-rate 2500 \
    --max-retries 1 -T3 -oG "$part1" "$TARGET" >/dev/null 2>&1 &
  pid1=$!

  sudo nmap -p22001-44000 --open -sS -n -Pn --min-rate 2500 \
    --max-retries 1 -T3 -oG "$part2" "$TARGET" >/dev/null 2>&1 &
  pid2=$!

  sudo nmap -p44001-65535 --open -sS -n -Pn --min-rate 2500 \
    --max-retries 1 -T3 -oG "$part3" "$TARGET" >/dev/null 2>&1 &
  pid3=$!

  ## check for failures of the scans
  rc=0

  wait "$pid1"; s1=$?
  wait "$pid2"; s2=$?
  wait "$pid3"; s3=$?

  [ $s1 -eq 0 ] || { warn "$(tab 2)" "Discovery scan failed: ports 1-22000 (rc=$s1)"; rc=1; }
  [ $s2 -eq 0 ] || { warn "$(tab 2)" "Discovery scan failed: ports 22001-44000 (rc=$s2)"; rc=1; }
  [ $s3 -eq 0 ] || { warn "$(tab 2)" "Discovery scan failed: ports 44001-65535 (rc=$s3)"; rc=1; }

  ## aggregate discovered ports
  : > "$discmap"
  [ -f "$part1" ] && cat "$part1" >> "$discmap"
  [ -f "$part2" ] && cat "$part2" >> "$discmap"
  [ -f "$part3" ] && cat "$part3" >> "$discmap"
  rm -f "$part1" "$part2" "$part3"

  discovered="$(grep -oP '\d{1,5}/open' "$discmap" 2>/dev/null \
                | cut -d'/' -f1 | sort -n -u || true)"

  if [ -z "$discovered" ]; then
    fail "$(tab 2)" "No open ports discovered."
    PORTS=""
    return 2
  fi

  summary="$(echo "$discovered" | tr '\n' ',' | sed 's/,$//')"
  info "$(tab 2)" "${PURPLE}Open ports discovered: ${BLUE}${summary}${END}"

  PORTS="$(echo "$discovered" | xargs | tr ' ' ',')"
  return 0
}

nmap-targeted() {
  local chunk=20
  local max_bg=2

  local tdir listfile count total idx start end chunkports
  local xml outfile
  local -a ports pids

  tdir="$NMAPDIR/targeted"
  listfile="$tdir/list"
  mkdir -p -- "$tdir" || return 2
  : > "$listfile"

  if [ -z "${PORTS:-}" ]; then
    fail "$(tab 1)" "No open ports detected; skipping targeted scan."
    return 2
  fi

  header "Targeted scanning on discovered ports (chunked: ${chunk}/run)..."
  follow "$(tab 2)" "As chunks finish, we harvest HTTP candidates and feed http-validate."

  # PORTS is "80,443,..." -> array ports[]
  IFS=',' read -r -a ports <<< "$PORTS"
  total="${#ports[@]}"
  [ "$total" -gt 0 ] || { fail "$(tab 1)" "No ports to scan."; return 2; }

  # local progress helper: overwrite one line
  _nmap_prog() {
    local done="$1" tot="$2"
    local pct=0
    if [ "$tot" -gt 0 ]; then
      pct=$(( (done * 100) / tot ))
    fi
    info "$(tab 1)" "${PURPLE}scan progress: ${BLUE}${done}/${tot} (${pct}%)${END}"
  }

  # compute number of chunks
  local nchunks=$(( (total + chunk - 1) / chunk ))
  local done=0

  # NOTE: we do not produce a single merged XML (that’s messy).
  # We produce targeted-XXX.xml files and a list file.

  for ((idx=0; idx<nchunks; idx++)); do
    start=$(( idx * chunk ))
    end=$(( start + chunk ))
    [ "$end" -gt "$total" ] && end="$total"

    # build CSV port list for this chunk
    chunkports=""
    local j
    for ((j=start; j<end; j++)); do
      if [ -n "$chunkports" ]; then
        chunkports+=",${ports[$j]}"
      else
        chunkports="${ports[$j]}"
      fi
    done

    outfile="$(printf '%s/targeted-%03d.xml' "$tdir" $((idx+1)) )"
    printf '%s\n' "$outfile" >> "$listfile"

    # run nmap for this chunk
    # (keep it quiet like you do elsewhere)
    sudo nmap -sCV -p"$chunkports" -n -Pn --max-retries 2 "$TARGET" \
      -oX "$outfile" >/dev/null 2>&1

    rc=$?
    done=$((done + 1))
    _nmap_prog "$done" "$nchunks"

    if [ $rc -ne 0 ]; then
      warn "$(tab 2)" "Targeted chunk failed (rc=$rc): ports $chunkports"
      continue
    fi

    # Feed HTTP-ish ports from this chunk into http-validate in the background,
    # while the next chunk starts scanning.
    #
    # Requires parse-http-targ to be sourced somewhere before this runs.
    #
    # IMPORTANT: avoid unlimited background jobs
    while [ "${#pids[@]}" -ge "$max_bg" ]; do
      # wait for the oldest
      wait "${pids[0]}" 2>/dev/null || true
      pids=("${pids[@]:1}")
    done

    ( export HTTPMODE=targeted; targ-http-ports "$outfile" | "$ROOTDIR/modules/http/http-validate" ) &
    pids+=("$!")
  done

  # wait for any remaining http-validate runs
  local pid
  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done

  printf '\n'  # end the progress line cleanly

  # Export a handle other modules can use if needed
  TARGETEDXML="$tdir"
  export TARGETEDXML
  return 0
}
