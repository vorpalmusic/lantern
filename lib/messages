### All user-facing output MUST go through helpers (err/warn/info/ok)
### Do not print raw color codes elsewhere.

### STDOUT AND STDERR HANDLING
out() { printf '%b\n' "$*"; }
failout() { >&2 printf '%b\n' "$*"; }
prompt() { printf '%b' "${ORANGE}[?] $*"${END}; }

### RESET, using name $END for ease
END="\e[0m"

### COLOR CODES
RED="\e[31m"
ORANGE="\033[38;5;208m"
YELLOW="\e[38;5;226m"
GREEN="\033[38;5;40m"
BLUE="\e[34m"
PURPLE="\033[38;5;92m"
CYAN="\e[36m"
GRAY="\e[90m"

###	MESSAGE CLASSIFICATION
##	EACH TAB PRINTS TWO SPACES OF INDENTATION, USE AS 'tab 3' for 6 spaces, etc.
TAB="  "   # two spaces per tab level
tab() {
  local n="${1:-0}"				# sets to 0 if no number is supplied
  local i=0
  case "$n" in ''|*[!0-9]*) n=0 ;; esac		# blocks non-numeric input and sets to 0
  while [ "$i" -lt "$n" ]; do
    printf "%s" "$TAB"
    i=$((i + 1))
  done
}

#	so every later messaging function expects a tab N
#	if there is no tab, the message should be: "" "message"
#	1 tab: "$(tab 1)" "message", etc.

## 	DEFENSIVE FUNCTION IN CASE tab IS NOT SUPPLIED TO MESSAGE HELPERS
split() {
  case "$1" in
    ''|*[![:space:]]*)
      # no indent supplied
      ind=""
      txt="$*"
      ;;
    *)
      # indent supplied
      ind="$1"
      shift
      txt="$*"
      ;;
  esac
}

##	STDOUT (1)
#	NEW HEADER MESSAGES PRINT IN CYAN AFTER AN ORANGE [*]. THEY ARE PRECEDED BY A BLANK LINE
header() {
  out ""
  split "$@"
  out "${ind}${ORANGE}[*] ${CYAN}${txt}${END}"
}

#	STATUS MESSAGES PRINT IN PURPLE AFTER AN ORANGE [*]. 
status() {
  split "$@"
  out "${ind}${ORANGE}[*] ${PURPLE}${txt}${END}"
}

#	TREASURE FINDINGS, e.g. domain added to /etc/hosts, probable user names added to users.txt
treasure() { split "$@"; out "${ind}${ORANGE}[+] ${GREEN}${txt}${END}"; }

#       'LIST' MESSAGES BENEATH ANY HEADER OR SUB-HEADER, usually take at least one tab
item() { split "$@"; out "${ind}${ORANGE}[:] ${BLUE}${txt}${END}"; }

#       INFO MESSAGES, e.g. non-essential component is missing, where to find .config, etc.
#	color after [*] is not set because it may contain multiple colors
info() { split "$@"; out "${ind}${ORANGE}[*]${END} ${txt}"; }

##	STDERR (2)
#       WARN MESSAGES -- INDICATES NON-FATAL ERROR, AT CURRENT TAB LEVEL, in yellow
warn() { split "$@"; failout "${ind}${YELLOW}[!] ${txt}${END}"; }

#	ERROR MESSAGE -- RETAINS APPRORPIATE TAB LEVEL TO INDICATE TO USER WHERE IT OCCURRED
fail() { split "$@"; failout "${ind}${RED}[!] ${txt}${END}"; }
