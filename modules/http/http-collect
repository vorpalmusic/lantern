#!/usr/bin/env bash
# http-collect  — conservative HTTP artifact collector using curl, openssl, and whatweb
# Usage:
#   http-collect OUTDIR IP PORT
set -euo pipefail

OUTDIR="${1:-}"
IP="${2:-}"
PORT="${3:-}"

if [ -z "$OUTDIR" ] || [ -z "$IP" ] || [ -z "$PORT" ]; then
  echo "Usage: $0 OUTDIR IP PORT" >&2
  exit 2
fi

DEST="$OUTDIR/http/$PORT"
mkdir -p "$DEST"

# Timeouts (seconds)
CURL_HEAD_TIMEOUT=8
CURL_BODY_TIMEOUT=12
CERT_TIMEOUT=4

# Heuristic scheme: assume HTTPS on "usual" TLS ports, else HTTP
SCHEME="http"
case "$PORT" in
  443|8443|9443|10443) SCHEME="https" ;;
esac

BASE_URL="$SCHEME://$IP:$PORT/"
ALT_URL=""
if [ "$SCHEME" = "http" ]; then
  ALT_URL="https://$IP:$PORT/"
else
  ALT_URL="http://$IP:$PORT/"
fi

# Helper: extract host from a URL
# Input: full URL; Output: hostname (no port), one per line
url_to_host() {
  sed -E 's#^[A-Za-z]+://##; s#/.*$##; s/:.*$//' | sed '/^$/d'
}

# Helper: extract hosts from Location headers (case-insensitive)
extract_location_hosts() {
  # reads headers from stdin
  awk 'BEGIN{IGNORECASE=1} $1=="Location:"{sub(/^[Ll]ocation:[[:space:]]*/,""); print}' \
    | tr -d '\r' \
    | url_to_host
}

# -------------------------------------------------------------------
# 1) HEADERS (fast) — save to headers.txt correctly
# -------------------------------------------------------------------
: > "$DEST/headers.txt"
curl -sS --max-time "$CURL_HEAD_TIMEOUT" -D "$DEST/headers.txt" -o /dev/null \
  "$BASE_URL" 2>/dev/null || true

# Also try the alternate scheme once; sometimes port 80 answers with HTTPS redirect weirdness
: > "$DEST/headers.alt.txt"
curl -sS --max-time "$CURL_HEAD_TIMEOUT" -D "$DEST/headers.alt.txt" -o /dev/null \
  "$ALT_URL" 2>/dev/null || true

# -------------------------------------------------------------------
# 2) BODY (follow redirects, browser UA) — save final effective URL too
# -------------------------------------------------------------------
: > "$DEST/effective-url.txt"
curl -sL --max-time "$CURL_BODY_TIMEOUT" \
  --user-agent "Mozilla/5.0 (Recon)" \
  -w '%{url_effective}\n' \
  "$BASE_URL" -o "$DEST/body.html" 2>/dev/null > "$DEST/effective-url.txt" || true

# -------------------------------------------------------------------
# 3) Redirect hostname extraction (EARLY + RELIABLE)
#    - from Location headers (base + alt)
#    - from effective final URL after -L
# -------------------------------------------------------------------
: > "$DEST/hosts_from_redirects.txt"

# Location: from initial responses
if [ -s "$DEST/headers.txt" ]; then
  extract_location_hosts < "$DEST/headers.txt" >> "$DEST/hosts_from_redirects.txt" || true
fi
if [ -s "$DEST/headers.alt.txt" ]; then
  extract_location_hosts < "$DEST/headers.alt.txt" >> "$DEST/hosts_from_redirects.txt" || true
fi

# Host from final effective URL (after redirects)
if [ -s "$DEST/effective-url.txt" ]; then
  url_to_host < "$DEST/effective-url.txt" >> "$DEST/hosts_from_redirects.txt" || true
fi

# Normalize/dedupe
if [ -s "$DEST/hosts_from_redirects.txt" ]; then
  sed '/^$/d' "$DEST/hosts_from_redirects.txt" | sort -u > "$DEST/.hosts_from_redirects.tmp" || true
  mv -f "$DEST/.hosts_from_redirects.tmp" "$DEST/hosts_from_redirects.txt"
fi

# -------------------------------------------------------------------
# 4) page title / fallback heading (guard against missing/empty body.html)
# -------------------------------------------------------------------
title="<no title>"
if [ -s "$DEST/body.html" ]; then
  body_oneline="$(tr -d '\r\n' < "$DEST/body.html" 2>/dev/null || true)"

  title="$(printf '%s' "$body_oneline" \
    | grep -ioP '(?<=<title>).*?(?=</title>)' 2>/dev/null \
    | head -n1 || true)"

  if [ -z "$title" ]; then
    title="$(printf '%s' "$body_oneline" \
      | grep -ioP '(?<=<h1>).*?(?=</h1>)' 2>/dev/null \
      | head -n1 || true)"
  fi

  if [ -z "$title" ]; then
    title="$(printf '%s' "$body_oneline" \
      | grep -ioP '(?<=<h2>).*?(?=</h2>)' 2>/dev/null \
      | head -n1 || true)"
  fi
fi
printf "%s\n" "${title:-<no title>}" > "$DEST/title.txt" || true

# -------------------------------------------------------------------
# 5) extract absolute hostnames from body (hosts_from_body.txt)
# -------------------------------------------------------------------
if [ -s "$DEST/body.html" ]; then
  grep -Eo 'https?://[^"'"'"' >]+' "$DEST/body.html" 2>/dev/null \
    | sed -E 's#https?://##I' \
    | cut -d/ -f1 \
    | sed -E 's/:.*$//' \
    | sort -u > "$DEST/hosts_from_body.txt" || true
else
  : > "$DEST/hosts_from_body.txt"
fi

# -------------------------------------------------------------------
# 6) extract obvious emails from body (emails.txt)
# -------------------------------------------------------------------
if [ -s "$DEST/body.html" ]; then
  grep -Eoi "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}" "$DEST/body.html" 2>/dev/null \
    | sort -u > "$DEST/emails.txt" || true
else
  : > "$DEST/emails.txt"
fi

# --- minimal extra pages: /contact[.html] and /about[.html] (no spider) ---
for extra in contact about; do
  out="$DEST/${extra}.html"
  : > "$out"

  for path in "${extra}.html" "${extra}"; do
    curl -sL --max-time 8 --user-agent "Mozilla/5.0 (Recon)" \
      "$BASE_URL$path" -o "$out" 2>/dev/null || true
    if [ -s "$out" ]; then
      break
    fi
  done

  if [ -s "$out" ]; then
    grep -Eoi "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}" "$out" 2>/dev/null \
      >> "$DEST/emails.txt" || true
  fi
done

if [ -s "$DEST/emails.txt" ]; then
  sort -u "$DEST/emails.txt" -o "$DEST/emails.txt"
fi

# -------------------------------------------------------------------
# 7) robots/sitemap
# -------------------------------------------------------------------
curl -sS --max-time 6 "${BASE_URL}robots.txt" -o "$DEST/robots.txt" 2>/dev/null || true
curl -sS --max-time 6 "${BASE_URL}sitemap.xml" -o "$DEST/sitemap.xml" 2>/dev/null || true

# -------------------------------------------------------------------
# 8) favicon + hash (useful for asset correlation)
# -------------------------------------------------------------------
curl -sS --max-time 6 "${BASE_URL}favicon.ico" -o "$DEST/favicon.ico" 2>/dev/null || true
if [ -f "$DEST/favicon.ico" ]; then
  if command -v python3 >/dev/null 2>&1; then
    python3 - <<PY > "$DEST/favicon.md5" 2>/dev/null || true
import hashlib
print(hashlib.md5(open('$DEST/favicon.ico','rb').read()).hexdigest())
PY
  elif command -v md5sum >/dev/null 2>&1; then
    md5sum "$DEST/favicon.ico" 2>/dev/null | awk '{print $1}' > "$DEST/favicon.md5" || true
  fi
fi

# -------------------------------------------------------------------
# 9) cert grab (best-effort; wrapped in timeout)
#    Use SNI: if we learned a redirect host, use it; else fall back to IP
# -------------------------------------------------------------------
sni="$IP"
if [ -s "$DEST/hosts_from_redirects.txt" ]; then
  sni="$(head -n1 "$DEST/hosts_from_redirects.txt" 2>/dev/null || echo "$IP")"
fi

if command -v timeout >/dev/null 2>&1 && command -v openssl >/dev/null 2>&1; then
  timeout "$CERT_TIMEOUT" bash -c "echo | openssl s_client -connect $IP:$PORT -servername $sni 2>/dev/null" \
    | openssl x509 -noout -text > "$DEST/cert.txt" 2>/dev/null || true
fi

# -------------------------------------------------------------------
# 10) whatweb fingerprint (if installed) — robust, never fatal
# -------------------------------------------------------------------
: > "$DEST/whatweb.txt"

WHATWEB_URL="$BASE_URL"
if command -v whatweb >/dev/null 2>&1; then
  WHATWEB_MAX_THREADS="${WHATWEB_MAX_THREADS:-8}"
  WHATWEB_OPEN_TIMEOUT="${WHATWEB_OPEN_TIMEOUT:-6}"
  WHATWEB_READ_TIMEOUT="${WHATWEB_READ_TIMEOUT:-10}"
  WHATWEB_TIMEOUT="${WHATWEB_TIMEOUT:-10}"
  WHATWEB_AGGRESSION="${WHATWEB_AGGRESSION:-1}"

  {
    echo "# whatweb against $WHATWEB_URL"
    echo "# started: $(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  } >> "$DEST/whatweb.txt"

  if command -v timeout >/dev/null 2>&1; then
    if ! timeout "$WHATWEB_TIMEOUT" \
          whatweb \
            -v \
            -a "$WHATWEB_AGGRESSION" \
            --max-threads="$WHATWEB_MAX_THREADS" \
            --open-timeout="$WHATWEB_OPEN_TIMEOUT" \
            --read-timeout="$WHATWEB_READ_TIMEOUT" \
            --color=never \
            "$WHATWEB_URL" >> "$DEST/whatweb.txt" 2>&1; then
      status=$?
      echo "# whatweb: non-zero exit ($status) (timeout or error; non-fatal)" >> "$DEST/whatweb.txt"
    fi
  else
    if ! whatweb \
          -v \
          -a "$WHATWEB_AGGRESSION" \
          --max-threads="$WHATWEB_MAX_THREADS" \
          --open-timeout="$WHATWEB_OPEN_TIMEOUT" \
          --read-timeout="$WHATWEB_READ_TIMEOUT" \
          --color=never \
          "$WHATWEB_URL" >> "$DEST/whatweb.txt" 2>&1; then
      status=$?
      echo "# whatweb: non-zero exit ($status) (error; non-fatal)" >> "$DEST/whatweb.txt"
    fi
  fi
else
  echo "whatweb not installed; skipping" > "$DEST/whatweb.txt"
fi

# -------------------------------------------------------------------
# 11) quick parsed summary file
# -------------------------------------------------------------------
{
  echo "effective_url:"
  sed -n '1,5p' "$DEST/effective-url.txt" 2>/dev/null || true
  echo
  echo "hosts_from_redirects:"
  sed -n '1,200p' "$DEST/hosts_from_redirects.txt" 2>/dev/null || true
  echo
  echo "hosts_from_body:"
  sed -n '1,200p' "$DEST/hosts_from_body.txt" 2>/dev/null || true
  echo
  echo "emails:"
  sed -n '1,200p' "$DEST/emails.txt" 2>/dev/null || true
} > "$DEST/summary.txt"

# Friendly short output for caller
echo "collected:$DEST"
[ -s "$DEST/hosts_from_redirects.txt" ] && echo "hosts_from_redirects: $(wc -l < "$DEST/hosts_from_redirects.txt" 2>/dev/null || true)"
[ -s "$DEST/hosts_from_body.txt" ] && echo "hosts_from_body: $(wc -l < "$DEST/hosts_from_body.txt" 2>/dev/null || true)"
[ -s "$DEST/emails.txt" ] && echo "emails: $(wc -l < "$DEST/emails.txt" 2>/dev/null || true)"
[ -s "$DEST/headers.txt" ] && echo "headers saved"
[ -s "$DEST/body.html" ] && echo "body saved (bytes: $(stat -c%s "$DEST/body.html" 2>/dev/null || echo 0))"
[ -s "$DEST/cert.txt" ] && echo "cert saved"
[ -s "$DEST/whatweb.txt" ] && echo "whatweb saved (bytes: $(stat -c%s "$DEST/whatweb.txt" 2>/dev/null || echo 0))"
