#!/usr/bin/env bash
### lantern/modules/http/http-master
### iteratively deepening web scanning and enumeration, fed by base URLs from http-validate
### author: J4CKD4W

. "$ROOTDIR/lib/messages"
. "$ROOTDIR/lib/parse/parse-whatweb"

http-master() {
  local httpdir canon
  local wl_vhost wl_paths
  local failflag=0
  local ww_summary_tsv ww_summary_txt katana_all vhosts_all ffuf_paths_all
  local hostname_count ip_count total_count
  local have_ffuf=0 have_whatweb=0 have_katana=0
  local DO_VHOST=0
  local MAX_JOBS jobcount

  # whatweb escalation knobs
  local WW_ESCALATE WW_ESCALATE_LEVEL WW_A1_TIMEOUT WW_A3_TIMEOUT
  WW_ESCALATE="${HTTP_WHATWEB_ESCALATE:-1}"
  WW_ESCALATE_LEVEL="${HTTP_WHATWEB_ESCALATE_LEVEL:-3}"
  WW_A1_TIMEOUT="${HTTP_WHATWEB_A1_TIMEOUT:-45}"
  WW_A3_TIMEOUT="${HTTP_WHATWEB_A3_TIMEOUT:-90}"

  httpdir="$BASEDIR/$TARGET/http"
  canon="$httpdir/canonical.tsv"

  # canonical must exist and be non-empty
  if [ ! -s "$canon" ]; then
    fail "http-master: canonical.tsv missing/empty: $canon"
    return 2
  fi

  # Tool availability
  if command -v ffuf >/dev/null 2>&1;    then have_ffuf=1;    fi
  if command -v whatweb >/dev/null 2>&1; then have_whatweb=1; fi
  if command -v katana >/dev/null 2>&1;  then have_katana=1;  fi

  # Wordlists (can be overridden via env)
  wl_vhost="${HTTP_VHOST_WORDLIST:-/usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt}"
  if [ ! -s "$wl_vhost" ]; then
    wl_vhost=""
  fi

  wl_paths="${HTTP_FFUF_WORDLIST:-/usr/share/seclists/Discovery/Web-Content/common.txt}"
  if [ ! -s "$wl_paths" ]; then
    wl_paths=""
  fi

  mkdir -p -- "$httpdir"

  # -----------------------------
  # Global ffuf mutex (avoid OOM)
  # -----------------------------
  ffuf-lock() {
    local lockfile lockdir
    lockfile="$httpdir/.ffuf.lock"
    lockdir="$httpdir/.ffuf.lockdir"

    if command -v flock >/dev/null 2>&1; then
      exec 9>"$lockfile"
      flock -x 9
      return 0
    fi

    while ! mkdir "$lockdir" 2>/dev/null; do
      sleep 0.2
    done
    return 0
  }

  ffuf-unlock() {
    local lockdir
    lockdir="$httpdir/.ffuf.lockdir"

    exec 9>&- 2>/dev/null || true
    rmdir "$lockdir" 2>/dev/null || true
  }

  # -----------------------------
  # Count hostname/ip/total endpoints from canonical
  # -----------------------------
  read -r hostname_count ip_count total_count <<EOF
$(awk -F'\t' '
  { total++ }
  $5=="hostname" { host++ }
  $5=="ip"       { ip++ }
  END { printf "%d %d %d\n", host+0, ip+0, total+0 }
' "$canon")
EOF

  # Decide whether vhost fuzzing is globally worth doing (and WHY not)
  DO_VHOST=0
  if [ "$hostname_count" -le 0 ]; then
    warn "$(tab 1)" "http-master: vhost fuzzing disabled (no hostnames discovered)."
  elif [ "$have_ffuf" -ne 1 ]; then
    warn "$(tab 1)" "http-master: vhost fuzzing disabled (ffuf not found in PATH)."
  elif [ -z "$wl_vhost" ]; then
    warn "$(tab 1)" "http-master: vhost fuzzing disabled (vhost wordlist missing/unreadable)."
  else
    DO_VHOST=1
    status "$(tab 1)" "${PURPLE}http-master: ${BLUE}vhost fuzzing enabled: ${hostname_count} hostname(s).${END}"
  fi

  header "http-master: beginning web enumeration in earnest..."
  status "$(tab 1)" "canonical endpoints: ${BLUE}${total_count} - hostname(s)=${hostname_count}, IP(s)=${ip_count}${END}"

  # Summary / key-artifact files (reset per run)
  ww_summary_tsv="$httpdir/whatweb-summary.tsv"
  ww_summary_txt="$httpdir/whatweb-summary.txt"
  katana_all="$httpdir/katana-all.txt"
  vhosts_all="$httpdir/vhosts-all.tsv"
  ffuf_paths_all="$httpdir/ffuf-paths-all.tsv"

  printf 'port\tscheme\thost\tcode\tbase_url\n' >"$ww_summary_tsv"
  : >"$ww_summary_txt"
  printf 'port\tscheme\taddr_type\tipport\tbase_host\tvhost\n' >"$vhosts_all"
  : >"$katana_all"
  printf 'port\tscheme\tipport\tstatus\turl\n' >"$ffuf_paths_all"

  # Concurrency across endpoints (used ONLY for whatweb stage)
  MAX_JOBS="${HTTP_JOBS:-2}"
  jobcount=0

  # -----------------------------
  # Helpers (per endpoint)
  # -----------------------------
  mk_base_url() {
    local port scheme url host
    port="$1"; scheme="$2"; url="$3"; host="$4"
    if [ -n "$url" ]; then
      printf '%s\n' "$url"
    else
      printf '%s://%s:%s/\n' "$scheme" "$host" "$port"
    fi
  }

  endpoint_dir() {
    # args: port host
    printf '%s/%s/%s\n' "$httpdir" "$1" "$2"
  }

  whatweb_should_escalate() {
    # Decide escalation based on whatweb -a 1 output line.
    # Args: line
    local line="${1:-}"
    local lc

    [ "$WW_ESCALATE" -eq 1 ] || return 1
    [ -n "$line" ] || return 1

    lc="${line,,}"

    # If it looks like JSON/script-only, escalation is usually wasted.
    case "$lc" in
      *"application/json"*|*"script[application/json]"*|*"json"* )
        case "$lc" in
          *"html"*|*"html5"* ) return 0 ;;
          * ) return 1 ;;
        esac
        ;;
    esac

    # Escalate on common HTML markers
    case "$lc" in
      *"html"*|*"html5"*|*"xhtml"*|*"doctype"*|*"text/html"* )
        return 0
        ;;
    esac

    return 1
  }

  run_whatweb_timed() {
    # Args: out_tmp, base_url, level, seconds
    # Uses `timeout` when available (preferred). Falls back to a safe kill-based timeout.
    local out_tmp="$1" base_url="$2" level="$3" seconds="$4"
    local rc=0
    local have_timeout=0 have_ionice=0 have_nice=0
    local prefix=()

    command -v timeout >/dev/null 2>&1 && have_timeout=1
    command -v ionice  >/dev/null 2>&1 && have_ionice=1
    command -v nice    >/dev/null 2>&1 && have_nice=1

    if [ "$have_ionice" -eq 1 ]; then prefix+=(ionice -c3); fi
    if [ "$have_nice"   -eq 1 ]; then prefix+=(nice -n 10); fi

    # Ensure file exists
    : >"$out_tmp" 2>/dev/null || true

    if [ "$have_timeout" -eq 1 ]; then
      # -k 5: send KILL 5s after TERM if still running
      # --preserve-status: keep child exit status when possible
      timeout --preserve-status -k 5 "${seconds}" \
        "${prefix[@]}" whatweb -a "$level" "$base_url" >"$out_tmp" 2>&1
      rc=$?
      return "$rc"
    fi

    # Fallback: background + kill
    local pid wpid
    "${prefix[@]}" whatweb -a "$level" "$base_url" >"$out_tmp" 2>&1 &
    pid=$!

    (
      sleep "$seconds"
      kill -TERM -- "$pid" 2>/dev/null || true
      sleep 5
      kill -KILL -- "$pid" 2>/dev/null || true
    ) &
    wpid=$!

    wait "$pid"; rc=$?

    kill "$wpid" 2>/dev/null || true
    wait "$wpid" 2>/dev/null || true

    return "$rc"
  }

  # -----------------------------
  # Stage helpers
  # -----------------------------
  run_vhost_one() {
    local port scheme url host atype ipport code
    local outdir base_url
    local vcsv vhosts_txt

    port="$1"; scheme="$2"; url="$3"; host="$4"; atype="$5"; ipport="$6"; code="$7"
    outdir="$(endpoint_dir "$port" "$host")"
    mkdir -p -- "$outdir"
    base_url="$(mk_base_url "$port" "$scheme" "$url" "$host")"
    base_url="${base_url//$'\r'/}"

    if [ "$DO_VHOST" -ne 1 ] || [ "$atype" != "hostname" ] || [ -z "$host" ]; then
      return 0
    fi

    info "$(tab 1)" "${PURPLE}vhost fuzzing: ${BLUE}$base_url${END}"

    vcsv="$outdir/vhosts.csv"
    vhosts_txt="$outdir/vhosts.txt"

    ffuf-lock
    ffuf -ac -w "$wl_vhost" \
      -u "${scheme}://${ipport}/" \
      -H "Host: FUZZ" \
      -mc 200,301,302,403 \
      -t 20 \
      -of csv -o "$vcsv" >/dev/null 2>&1
    ffuf-unlock

    if [ ! -s "$vcsv" ] || [ "$(wc -l < "$vcsv")" -le 1 ]; then
      warn "$(tab 1)" "vhost-scan: no vhosts (or blocked); keeping base host only."
      return 0
    fi

    treasure "$(tab 1)" "vhost candidates saved: $vcsv"

    awk -F',' 'NR==1{for(i=1;i<=NF;i++) if($i=="input"){col=i}; next}
              col{gsub(/^[ \t"]+|[ \t"]+$/,"",$col); if($col!="") print $col}' \
      "$vcsv" | sort -u >"$vhosts_txt"

    if [ -s "$vhosts_txt" ]; then
      while IFS= read -r sub; do
        [ -n "$sub" ] || continue
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
          "$port" "$scheme" "$atype" "$ipport" "$host" "$sub" >>"$vhosts_all"
      done <"$vhosts_txt"
    fi
  }

  run_whatweb_one() {
    local port scheme url host atype ipport code
    local outdir base_url
    local wwout ww_a1 ww_a3 wwtmp1 wwtmp3
    local rc1 rc3
    local firstline=""

    port="$1"; scheme="$2"; url="$3"; host="$4"; atype="$5"; ipport="$6"; code="$7"
    [ -n "$code" ] || code="-"

    outdir="$(endpoint_dir "$port" "$host")"
    mkdir -p -- "$outdir"
    base_url="$(mk_base_url "$port" "$scheme" "$url" "$host")"
    base_url="${base_url//$'\r'/}"

    # Guard: skip obvious junk endpoints (e.g., 404)
    case "$code" in
      200|204|301|302|307|308|401|403) : ;;
      *) info "$(tab 1)" "${PURPLE}whatweb: ${ORANGE}skipping (code=${code}) $base_url${END}"; return 0 ;;
    esac

    info "$(tab 1)" "${PURPLE}whatweb: ${BLUE}$base_url${END}"

    if [ "$have_whatweb" -ne 1 ]; then
      warn "$(tab 1)" "whatweb not found in PATH; skipping fingerprint phase for $base_url."
      return 0
    fi

    wwout="$outdir/whatweb.txt"
    ww_a1="$outdir/whatweb.a1.txt"
    ww_a3="$outdir/whatweb.a3.txt"

    wwtmp1="$(mktemp /dev/shm/whatweb.a1.XXXXXX 2>/dev/null)" || wwtmp1=""
    [ -n "$wwtmp1" ] || wwtmp1="$(mktemp "$outdir/whatweb.a1.tmp.XXXXXX" 2>/dev/null)" || wwtmp1="$outdir/whatweb.a1.tmp"

    rc1=0
    run_whatweb_timed "$wwtmp1" "$base_url" 1 "$WW_A1_TIMEOUT" || rc1=$?

    if [ -s "$wwtmp1" ]; then
      cat "$wwtmp1" >"$ww_a1" 2>/dev/null || : >"$ww_a1"
      firstline="$(head -n 1 "$ww_a1" 2>/dev/null || true)"
    else
      : >"$ww_a1"
      firstline=""
    fi
    rm -f -- "$wwtmp1" 2>/dev/null || true

    if [ "$rc1" -ne 0 ]; then
      warn "$(tab 1)" "whatweb: exit=$rc1 (timeout/kill/error) probing $base_url (see $ww_a1)"
    fi

    # Conditional escalation: only if A1 suggests HTML-ish content
    rc3=0
    if whatweb_should_escalate "$firstline"; then
      info "$(tab 2)" "${PURPLE}whatweb: ${CYAN}escalating to -a ${WW_ESCALATE_LEVEL}${BLUE}: ${base_url}${END}"

      wwtmp3="$(mktemp /dev/shm/whatweb.a3.XXXXXX 2>/dev/null)" || wwtmp3=""
      [ -n "$wwtmp3" ] || wwtmp3="$(mktemp "$outdir/whatweb.a3.tmp.XXXXXX" 2>/dev/null)" || wwtmp3="$outdir/whatweb.a3.tmp"

      run_whatweb_timed "$wwtmp3" "$base_url" "$WW_ESCALATE_LEVEL" "$WW_A3_TIMEOUT" || rc3=$?

      if [ -s "$wwtmp3" ]; then
        cat "$wwtmp3" >"$ww_a3" 2>/dev/null || : >"$ww_a3"
      else
        : >"$ww_a3"
      fi
      rm -f -- "$wwtmp3" 2>/dev/null || true

      if [ "$rc3" -ne 0 ]; then
        warn "$(tab 2)" "whatweb: exit=$rc3 (timeout/kill/error) probing $base_url at -a ${WW_ESCALATE_LEVEL} (see $ww_a3)"
      fi
    else
      : >"$ww_a3" 2>/dev/null || true
    fi

    # Compose final whatweb.txt
    : >"$wwout"
    if [ -s "$ww_a1" ]; then
      cat "$ww_a1" >>"$wwout" 2>/dev/null || true
    fi
    if [ -s "$ww_a3" ]; then
      printf '\n' >>"$wwout"
      cat "$ww_a3" >>"$wwout" 2>/dev/null || true
    fi

    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$port" "$scheme" "$host" "$code" "$base_url" >>"$ww_summary_tsv"

    {
      printf '### %s\n' "$base_url"
      head -n 1 "$wwout" 2>/dev/null || true
      printf '\n'
    } >>"$ww_summary_txt"
  }

  run_katana_one() {
    local port scheme url host atype ipport code
    local outdir base_url kout

    port="$1"; scheme="$2"; url="$3"; host="$4"; atype="$5"; ipport="$6"; code="$7"
    outdir="$(endpoint_dir "$port" "$host")"
    mkdir -p -- "$outdir"
    base_url="$(mk_base_url "$port" "$scheme" "$url" "$host")"
    base_url="${base_url//$'\r'/}"

    info "$(tab 1)" "${PURPLE}katana: ${BLUE}$base_url${END}"

    if [ "$have_katana" -ne 1 ]; then
      warn "$(tab 1)" "katana not found in PATH; skipping crawl phase for $base_url."
      return 0
    fi

    kout="$outdir/katana.txt"
    katana -u "$base_url" -silent -no-color >"$kout" 2>&1 || {
      warn "$(tab 1)" "katana: error crawling $base_url (see $kout)"
    }

    {
      printf '### %s\n' "$base_url"
      cat "$kout" 2>/dev/null || true
      printf '\n'
    } >>"$katana_all"
  }

  run_ffuf_paths_one() {
    local port scheme url host atype ipport code
    local outdir base_url fcsv ftxt

    port="$1"; scheme="$2"; url="$3"; host="$4"; atype="$5"; ipport="$6"; code="$7"
    outdir="$(endpoint_dir "$port" "$host")"
    mkdir -p -- "$outdir"
    base_url="$(mk_base_url "$port" "$scheme" "$url" "$host")"
    base_url="${base_url//$'\r'/}"

    if [ "$have_ffuf" -ne 1 ] || [ -z "$wl_paths" ]; then
      return 0
    fi

    info "$(tab 1)" "${PURPLE}ffuf-paths: ${BLUE}$base_url${END}"

    fcsv="$outdir/ffuf-dirs.csv"
    ftxt="$outdir/ffuf-dirs.txt"

    ffuf-lock
    ffuf -ac -w "$wl_paths" \
      -u "${base_url}FUZZ" \
      -mc 200,204,301,302,307,401,403 \
      -t 20 \
      -of csv -o "$fcsv" >/dev/null 2>&1 || {
      warn "$(tab 1)" "error fuzzing ${base_url}FUZZ (see $fcsv)"
    }
    ffuf-unlock

    if [ ! -s "$fcsv" ] || [ "$(wc -l < "$fcsv")" -le 1 ]; then
      info "$(tab 1)" "${PURPLE}ffuf-paths: ${ORANGE}no interesting results.${END}"
      return 0
    fi

    treasure "$(tab 1)" "${PURPLE}ffuf-paths: ${BLUE}candidates saved: ${CYAN}$fcsv${END}"

    awk -F',' '
      NR==1{
        for(i=1;i<=NF;i++){
          if($i=="url") uc=i
          if($i=="status_code") sc=i
        }
        next
      }
      uc && sc {
        u=$uc; s=$sc
        gsub(/^[ \t"]+|[ \t"]+$/,"",u)
        if(u!="") print u "\t" s
      }
    ' "$fcsv" >"$ftxt"

    if [ -s "$ftxt" ]; then
      while IFS=$'\t' read -r u sc; do
        [ -n "$u" ] || continue
        printf '%s\t%s\t%s\t%s\t%s\n' \
          "$port" "$scheme" "$ipport" "$sc" "$u" >>"$ffuf_paths_all"
      done <"$ftxt"
    fi
  }

  # --------------------------------
  # Stage 0: vhost fuzzing (SERIAL)
  # --------------------------------
  if [ "$DO_VHOST" -eq 1 ]; then
    info "$(tab 1)" "${ORANGE}stage 0: ${CYAN}vhost fuzzing (one at a time)${END}"
    while IFS=$'\t' read -r port scheme url host atype ipport code; do
      port="${port//$'\r'/}"; scheme="${scheme//$'\r'/}"; url="${url//$'\r'/}"
      host="${host//$'\r'/}"; atype="${atype//$'\r'/}"; ipport="${ipport//$'\r'/}"; code="${code//$'\r'/}"

      [ -n "${port:-}" ]   || continue
      [ -n "${scheme:-}" ] || continue
      [ -n "${host:-}" ]   || continue
      [ -n "${ipport:-}" ] || continue
      run_vhost_one "$port" "$scheme" "$url" "$host" "$atype" "$ipport" "$code"
    done <"$canon"
  fi

  # --------------------------------
  # Stage 1: whatweb (CONCURRENT)
  # --------------------------------
  info "$(tab 1)" "${ORANGE}stage 1 of 3: ${CYAN}whatweb fingerprinting (up to ${MAX_JOBS} concurrent)${END}"
  if [ "$have_whatweb" -ne 1 ]; then
    warn "$(tab 1)" "http-master: whatweb not found; stage will be skipped."
  else
    jobcount=0
    while IFS=$'\t' read -r port scheme url host atype ipport code; do
      port="${port//$'\r'/}"; scheme="${scheme//$'\r'/}"; url="${url//$'\r'/}"
      host="${host//$'\r'/}"; atype="${atype//$'\r'/}"; ipport="${ipport//$'\r'/}"; code="${code//$'\r'/}"

      [ -n "${port:-}" ]   || continue
      [ -n "${scheme:-}" ] || continue
      [ -n "${host:-}" ]   || continue
      [ -n "${ipport:-}" ] || continue

      run_whatweb_one "$port" "$scheme" "$url" "$host" "$atype" "$ipport" "$code" &
      jobcount=$((jobcount+1))

      if [ "$jobcount" -ge "$MAX_JOBS" ]; then
        wait -n 2>/dev/null || wait
        jobcount=$((jobcount-1))
      fi
    done <"$canon"
    wait
  fi

  # --------------------------------
  # Stage 2: katana (SERIAL)
  # --------------------------------
  info "$(tab 1)" "${ORANGE}stage 2 of 3: ${CYAN}katana crawling (one at a time)${END}"
  if [ "$have_katana" -ne 1 ]; then
    warn "$(tab 1)" "http-master: katana not found; stage will be skipped."
  else
    while IFS=$'\t' read -r port scheme url host atype ipport code; do
      port="${port//$'\r'/}"; scheme="${scheme//$'\r'/}"; url="${url//$'\r'/}"
      host="${host//$'\r'/}"; atype="${atype//$'\r'/}"; ipport="${ipport//$'\r'/}"; code="${code//$'\r'/}"

      [ -n "${port:-}" ]   || continue
      [ -n "${scheme:-}" ] || continue
      [ -n "${host:-}" ]   || continue
      [ -n "${ipport:-}" ] || continue
      run_katana_one "$port" "$scheme" "$url" "$host" "$atype" "$ipport" "$code"
    done <"$canon"
  fi

  # --------------------------------
  # Stage 3: ffuf paths (SERIAL)
  # --------------------------------
  info "$(tab 1)" "${ORANGE}stage 3 of 3: ${CYAN}ffuf path fuzzing (one at a time)${END}"
  if [ "$have_ffuf" -ne 1 ] || [ -z "$wl_paths" ]; then
    warn "$(tab 1)" "http-master: ffuf or paths wordlist missing; stage will be skipped."
  else
    while IFS=$'\t' read -r port scheme url host atype ipport code; do
      port="${port//$'\r'/}"; scheme="${scheme//$'\r'/}"; url="${url//$'\r'/}"
      host="${host//$'\r'/}"; atype="${atype//$'\r'/}"; ipport="${ipport//$'\r'/}"; code="${code//$'\r'/}"

      [ -n "${port:-}" ]   || continue
      [ -n "${scheme:-}" ] || continue
      [ -n "${host:-}" ]   || continue
      [ -n "${ipport:-}" ] || continue
      run_ffuf_paths_one "$port" "$scheme" "$url" "$host" "$atype" "$ipport" "$code"
    done <"$canon"
  fi

  # -----------------------------------------
  # Phase 4: merge WhatWeb -> versions.tsv
  # -----------------------------------------
  if [ "$have_whatweb" -eq 1 ]; then
    local wwlist
    wwlist="$httpdir/whatweb-files.lst"

    find "$httpdir" -type f -name 'whatweb.txt' -size +0c > "$wwlist"

    if [ -s "$wwlist" ]; then
      info "$(tab 1)" "${PURPLE}http-master: ${CYAN}merging whatweb results into versions.tsv${END}"
      whatweb-to-versions "$wwlist" "$OUTDIR/versions.tsv" \
        || warn "$(tab 1)" "whatweb merge failed (versions.tsv unchanged)."
    else
      warn "$(tab 1)" "http-master: no whatweb.txt outputs found to merge."
    fi
  fi

  return "$failflag"
}

http-master
