#!/bin/bash
### lantern/modules/http/http-validate
### HTTP validation for probable web ports (early + targeted modes)
### author: J4CKD4W

. "$ROOTDIR/lib/messages"
. "$ROOTDIR/lib/webber"
. "$ROOTDIR/lib/parse/parse-http"

HTTPMODE="${HTTPMODE:-early}"   # early | targeted

# require ports on stdin
if [ -t 0 ]; then
  fail "http-validate: expected ports on stdin (pipe ports into http-validate)"
  exit 2
fi

mkhttpdir   # sets $httpdir

# mode-specific dirs/files
if [ "$HTTPMODE" = "targeted" ]; then
  mydir="$httpdir/targvalidate"
  portlist="$httpdir/ports.targ.in"
  tsv="$httpdir/httptarg.tsv"
  lock="$httpdir/.lock.httptarg"
else
  mydir="$httpdir/validate"
  portlist="$httpdir/ports.in"
  tsv="$httpdir/validate.tsv"
fi

mkdir -p -- "$mydir"
: > "$portlist"

# ---------- helpers ----------

already_early() {
  local p="$1"
  ls "$httpdir/validate/$p"/*.meta >/dev/null 2>&1
}

already_targeted() {
  local p="$1"
  ls "$httpdir/targvalidate/$p"/*.meta >/dev/null 2>&1
}

# rebuild canonical.tsv from validate.tsv + httptarg.tsv (best per port/scheme)
canon-rebuild() {
  local canon="$httpdir/canonical.tsv"
  local t1="$httpdir/validate.tsv"
  local t2="$httpdir/httptarg.tsv"
  local -a inputs=()

  [ -s "$t1" ] && inputs+=("$t1")
  [ -s "$t2" ] && inputs+=("$t2")

  # If nothing to work with, just create an empty canonical (no rows).
  if [ "${#inputs[@]}" -eq 0 ]; then
    : > "$canon"
    return 0
  fi

  # Build into a temp file, then sort to final canonical.tsv.
  awk -F'\t' -v out="$canon" '
    BEGIN {
      OFS = "\t"
      tmp = out ".tmp"
    }

    # Normalize HTTP status code to 3 digits or "000" (meaning: unusable/unknown)
    function norm_code(c) {
      if (c ~ /^[1-5][0-9][0-9]$/) return c
      return "000"
    }

    # Decide whether this row becomes the best for (port, scheme)
    function consider(port, scheme, follow, code, effective, remote, location,
                      base, score, key, origin) {
      code = norm_code(code)

      # Drop non-HTTP / failed / unparsable responses
      if (code == "000") return

      # Base URL: prefer Location if present, otherwise the effective URL
      base = (location != "" ? location : effective)
      if (base == "") return

      # If Location is relative, resolve it against effective host:port
      if (base !~ /^https?:\/\// && effective ~ /^https?:\/\//) {
        origin = effective
        sub(/^https?:\/\//, "", origin)   # strip scheme
        sub(/\/.*/, "", origin)           # keep host[:port]

        # Ensure relative path is rooted
        if (base !~ /^\//) base = "/" base

        base = scheme "://" origin base
      }

      # Scoring:
      #  - Prefer 2xx, then 401/403, then 3xx, then generic 4xx/5xx, then everything else
      score = 0
      if (code ~ /^20[0-9]$/)                  score = 400
      else if (code == "401" || code == "403") score = 350
      else if (code ~ /^3[0-9][0-9]$/)         score = 300
      else if (code ~ /^4[0-9][0-9]$/)         score = 200
      else if (code ~ /^5[0-9][0-9]$/)         score = 150
      else                                     score = 100

      # Small bonus for follow=yes, so final destinations win
      if (follow == "follow") score += 5

      key = port "\t" scheme

      if (!(key in best_score) || score > best_score[key]) {
        best_score[key]  = score
        best_remote[key] = remote
        best_url[key]    = base
        best_code[key]   = code
      }
    }

    # Skip TSV headers in each validate/httptarg file
    FNR == 1 { next }

    {
      port      = $1
      scheme    = $2
      follow    = $3
      code      = $4
      effective = $5

      # Defensive: only grab these if present, avoid blowing up on short rows
      remote    = (NF >= 10 ? $10 : "")
      location  = (NF >= 12 ? $12 : "")

      consider(port, scheme, follow, code, effective, remote, location)
    }

    END {
      # No header line in canonical.tsv (preserve existing behavior).
      # Row layout:
      #   port  scheme  url  host  addressing  remote  code

      for (k in best_url) {
        split(k, a, "\t")
        port   = a[1]
        scheme = a[2]
        url    = best_url[k]
        code   = best_code[k]
        remote = best_remote[k]

        host = url
        sub(/^https?:\/\//, "", host)
        sub(/[\/:].*$/, "", host)

        if (host == "") {
          addressing = "unknown"
        } else if (host ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
          addressing = "ip"
        } else {
          addressing = "hostname"
        }

        print port, scheme, url, host, addressing, remote, code >> tmp
      }
    }
  ' "${inputs[@]}"

  # Sort canon by port then scheme for stable, deterministic ordering
  if [ -f "${canon}.tmp" ]; then
    sort -t $'\t' -k1,1n -k2,2 "${canon}.tmp" > "$canon"
    rm -f -- "${canon}.tmp"
  else
    # If awk produced nothing (e.g. everything was code 000), just empty canonical.
    : > "$canon"
  fi
}

# ---------- collect ports ----------

declare -A seen
count=0

while IFS= read -r port; do
  # strip leading/trailing whitespace
  port="${port#"${port%%[![:space:]]*}"}"
  port="${port%"${port##*[![:space:]]}"}"

  [ -n "$port" ] || continue
  [[ "$port" =~ ^[0-9]+$ ]] || continue
  [ "$port" -ge 1 ] 2>/dev/null || continue
  [ "$port" -le 65535 ] 2>/dev/null || continue

  [ -n "${seen[$port]:-}" ] && continue
  seen["$port"]=1

  if [ "$HTTPMODE" = "targeted" ]; then
    already_early "$port" && continue
    already_targeted "$port" && continue
  fi

  printf '%s\n' "$port" >> "$portlist"
  count=$((count + 1))
done

[ "$count" -gt 0 ] || {
  info "$(tab 1)" "${PURPLE}http-validate:${END} ${BLUE}no candidate ports received${END}"
  exit 0
}

# ---------- curl validate ----------

if [ "$HTTPMODE" = "targeted" ]; then
  info "$(tab 1)" "${CYAN}Targeted HTTP validation (skipping ports already validated).${END}"
else
  header "Validating probable HTTP/S ports in parallel with targeted nmap scan."
fi

while IFS= read -r port; do
  pdir="$mydir/$port"
  mkdir -p -- "$pdir"

  curler "$port" "$pdir"
  curler "$port" "$pdir" -s
  curler "$port" "$pdir" -L
  curler "$port" "$pdir" -s -L
done < "$portlist"

# ---------- TSV build/update + canonical (both modes) ----------

if [ "$HTTPMODE" = "targeted" ]; then
  (
    # serialize TSV rebuild for targeted mode
    while ! mkdir "$lock" 2>/dev/null; do sleep 0.1; done

    tsv-init "$tsv" || { rmdir "$lock"; warn "$(tab 2)" "$argserr"; exit 1; }

    # walk every meta under targvalidate/<port> and add rows
    for mf in "$mydir"/*/*.meta; do
      [ -s "$mf" ] || continue   # skip missing/empty meta quietly
      hf="${mf%.meta}.header"
      tsv-addrow "$tsv" "$mf" "$hf" || warn "$(tab 2)" "$argserr"
    done

    rmdir "$lock"
  )
else
  # early mode: rebuild validate.tsv from all validate/<port>/*.meta
  tsv-init "$tsv" || { warn "$(tab 2)" "$argserr"; exit 1; }

  for mf in "$mydir"/*/*.meta; do
    [ -s "$mf" ] || continue
    hf="${mf%.meta}.header"
    tsv-addrow "$tsv" "$mf" "$hf" || warn "$(tab 2)" "$argserr"
  done
fi

canon-rebuild
info "$(tab 1)" "${PURPLE}http-validate:${END} ${GREEN}http endpoints rebuilt: $(basename "$tsv")${END}"
exit 0
