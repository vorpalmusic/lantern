#!/bin/bash
### lantern/modules/http/http-validate
### HTTP validation for probable web ports (early + targeted modes)
### author: J4CKD4W

. "$ROOTDIR/lib/messages"
. "$ROOTDIR/lib/webber"
. "$ROOTDIR/lib/parse/parse-http"

HTTPMODE="${HTTPMODE:-early}"   # early | targeted

# require ports on stdin
if [ -t 0 ]; then
  fail "http-validate: expected ports on stdin (pipe ports into http-validate)"
  exit 2
fi

mkhttpdir   # sets $httpdir

# mode-specific dirs/files
if [ "$HTTPMODE" = "targeted" ]; then
  mydir="$httpdir/targvalidate"
  portlist="$httpdir/ports.targ.in"
  tsv="$httpdir/httptarg.tsv"
  lock="$httpdir/.lock.httptarg"
else
  mydir="$httpdir/validate"
  portlist="$httpdir/ports.in"
  tsv="$httpdir/validate.tsv"
fi

mkdir -p -- "$mydir"
: > "$portlist"

# ---------- helpers ----------

already_early() {
  local p="$1"
  ls "$httpdir/validate/$p"/*.meta >/dev/null 2>&1
}

already_targeted() {
  local p="$1"
  ls "$httpdir/targvalidate/$p"/*.meta >/dev/null 2>&1
}

# rebuild canonical.tsv from validate.tsv + httptarg.tsv (best per port/scheme)
canon-rebuild() {
  local canon="$httpdir/canonical.tsv"
  local t1="$httpdir/validate.tsv"
  local t2="$httpdir/httptarg.tsv"
  local -a inputs=()

  [ -s "$t1" ] && inputs+=("$t1")
  [ -s "$t2" ] && inputs+=("$t2")

  if [ "${#inputs[@]}" -eq 0 ]; then
    : > "$canon"
    return 0
  fi

  awk -F'\t' '
    function consider(port, scheme, follow, code, effective, remote, location,   base, score, key, origin) {
      if (code == "000" || code == "") return

      # choose base URL: prefer Location if present, else effective
      base = (location != "" ? location : effective)

      # FIX: if Location is relative (e.g. /login.php), resolve against effective host:port
      # This prevents bogus host extraction (""), which used to fall into "hostname".
      if (base !~ /^https?:\/\// && effective ~ /^https?:\/\//) {
  	origin = effective
  	sub(/^https?:\/\//, "", origin)   # strip scheme
  	sub(/\/.*/, "", origin)           # strip path -> host[:port]

  	# if it does not start with "/", make it root-relative
  	if (base !~ /^\//) base = "/" base

  	if (scheme == "https") base = "https://" origin base
  	else base = "http://" origin base
      }
      score = 0
      if (code == "200" || code == "204")           score = 300
      else if (code == "401" || code == "403")      score = 250
      else if (code ~ /^3[0-9][0-9]$/)              score = 200
      else                                          score = 100

      if (follow == "follow") score += 10

      key = port "\t" scheme
      if (!(key in best_score) || score > best_score[key]) {
        best_score[key]  = score
        best_remote[key] = remote
        best_url[key]    = base
      }
    }

    FNR==1 { next }  # skip headers in each TSV

    {
      port      = $1
      scheme    = $2
      follow    = $3
      code      = $4
      effective = $5
      remote    = $10
      location  = $12
      consider(port, scheme, follow, code, effective, remote, location)
    }

    END {
      for (k in best_url) {
        split(k, a, "\t")
        port=a[1]; scheme=a[2]; url=best_url[k]

        host=url
        sub(/^https?:\/\//, "", host)
        sub(/[\/:].*$/, "", host)

        # if host is empty, mark unknown (shouldn’t happen now, but safety)
        if (host == "") {
          addressing="unknown"
        } else if (host ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
          addressing="ip"
        } else {
          addressing="hostname"
        }

        print port "\t" scheme "\t" url "\t" host "\t" addressing "\t" best_remote[k]
      }
    }
  ' "${inputs[@]}" | sort -t $'\t' -k1,1n -k2,2 > "$canon"
}

# ---------- collect ports ----------
declare -A seen
count=0

while IFS= read -r port; do
  port="${port#"${port%%[![:space:]]*}"}"
  port="${port%"${port##*[![:space:]]}"}"

  [ -n "$port" ] || continue
  [[ "$port" =~ ^[0-9]+$ ]] || continue
  [ "$port" -ge 1 ] 2>/dev/null || continue
  [ "$port" -le 65535 ] 2>/dev/null || continue

  [ -n "${seen[$port]:-}" ] && continue
  seen["$port"]=1

  if [ "$HTTPMODE" = "targeted" ]; then
    already_early "$port" && continue
    already_targeted "$port" && continue
  fi

  printf '%s\n' "$port" >> "$portlist"
  count=$((count + 1))
done

[ "$count" -gt 0 ] || {
  info "$(tab 1)" "${PURPLE}http-validate:${END} ${BLUE}no candidate ports received${END}"
  exit 0
}

# ---------- curl validate ----------
if [ "$HTTPMODE" = "targeted" ]; then
  info "$(tab 1)" "${CYAN}Targeted HTTP validation (skipping ports already validated).${END}"
else
  header "Validating probable HTTP/S ports in parallel with targeted nmap scan."
fi

while IFS= read -r port; do
  pdir="$mydir/$port"
  mkdir -p -- "$pdir"

  curler "$port" "$pdir"
  curler "$port" "$pdir" -s
  curler "$port" "$pdir" -L
  curler "$port" "$pdir" -s -L
done < "$portlist"

# ---------- TSV build/update ----------
if [ "$HTTPMODE" = "targeted" ]; then
  (
    while ! mkdir "$lock" 2>/dev/null; do sleep 0.1; done

    if [ ! -s "$tsv" ]; then
      tsv-init "$tsv" || { rmdir "$lock"; warn "$(tab 2)" "$argserr"; exit 1; }
    fi

    while IFS= read -r port; do
      for mf in "$mydir/$port"/*.meta; do
        [ -s "$mf" ] || continue   # skip missing/empty meta quietly
        hf="${mf%.meta}.header"
        tsv-addrow "$tsv" "$mf" "$hf" || warn "$(tab 2)" "$argserr"
      done
    done < "$portlist"

    rmdir "$lock"
  )

  canon-rebuild
  info "$(tab 1)" "${PURPLE}http-validate:${END} ${GREEN}http endpoints appended: $(basename "$tsv")${END}"
  exit 0
fi

# early: rebuild validate.tsv from scratch
tsv-init "$tsv" || { warn "$(tab 2)" "$argserr"; exit 1; }
for mf in "$mydir"/*/*.meta; do
  [ -s "$mf" ] || continue   # skip missing/empty meta quietly
  hf="${mf%.meta}.header"
  tsv-addrow "$tsv" "$mf" "$hf" || warn "$(tab 2)" "$argserr"
done

canon-rebuild
exit 0
