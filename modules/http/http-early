#!/bin/bash
### lantern/modules/http/http-early
### very early simple validation for probable web ports
### author: J4CKD4W

. "$ROOTDIR/lib/messages"

# require ports on stdin (nmap-check | http-early ...)
if [ -t 0 ]; then
  fail "http-early: expected ports on stdin (pipe nmap-check into http-early)"
  exit 2
fi

httpdir="$OUTDIR/http"
mkdir -p "$httpdir"

portlist="$httpdir/ports.in"
: > "$portlist"

declare -A seen
count=0

while IFS= read -r port; do
  # trim whitespace
  port="${port#"${port%%[![:space:]]*}"}"
  port="${port%"${port##*[![:space:]]}"}"

  [ -n "$port" ] || continue
  [[ "$port" =~ ^[0-9]+$ ]] || continue
  [ "$port" -ge 1 ] 2>/dev/null || continue
  [ "$port" -le 65535 ] 2>/dev/null || continue

  [ -n "${seen[$port]:-}" ] && continue
  seen["$port"]=1

  printf '%s\n' "$port" >> "$portlist"
  count=$((count +1))
done

[ "$count" -gt 0 ] || { warn "http-early: no candidate ports received"; exit 0; }
