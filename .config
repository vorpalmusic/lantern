### lantern config
### lantern/.confg
### author: J4CKD4W

VERSION="0.0.003"
## init=1 means this is the first time lantern has ever been run on this machine
## as a result, it will install a global symlink, check dependencies, etc.
## (do not touch unless troubleshooting bootstrap)
INIT=0
## depcheck will be set to 1 if lantern has validated that all dependencies are installed
## depcheck=1 means that all required dependencies are already installed
## again, do not touch unless troubleshooting
DEPCHECK=1

## outfolder="." means lantern will use the current working directory to place all outputs
## to change, set as a path, e.g. "/home/lantern"
OUTFOLDER="."

### future switches that are not implemented
## which port to use for displaying the web report
# webport=9999
## should the web report open the browser and display itself immediately when done? 1=yes
# webopen=1
## should lantern kill any process already using the webport? 1=yes
# webkill=1

## place commands from repositories here:
katanapath=/home/kali/go/bin/katana
