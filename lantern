#!/bin/bash
### lantern:
### modular and automated pen-testing enumeration and reporting tool
### author: J4CKD4W

### DO NOT RUN LANTERN AS ROOT
if [ "${EUID:-$(id -u)}" -eq 0 ]; then
  fail "Run as a normal user; lantern will ask for sudo when needed." >&2
  exit 1
fi

### Grab ROOTDIR, path variables and necessary libraries
PATHFINDER="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)/lib/pathfinder"
export PATHFINDER
. "$PATHFINDER"
. "$ROOTDIR/lib/messages"
. "$ROOTDIR/lib/args"
. "$LIBDIR/priv"
. "$CONFIG"

info "${CYAN}lantern should never be run as sudo, but requires sudo for some tasks. Please authorize now.${END}"
sinit

### Handle arguments and flags
parseargs "$@"

case "$ACTION" in
  help)    argshelp; exit 0 ;;
  version) argsversion; exit 0 ;;
  config)  nano "$CONFIG"; exit 0 ;;
  error)   fail "${RED}Error:${END} $ARGSERR" >&2; exit 2 ;;
  run)     : ;;
esac

### parseargs determined the target. ALL other scripts will need it. ONLY this and PATHFINDER are exported
export TARGET

### now source libraries that depend on TARGET being set
. "$LIBDIR/nmapper"

### CHECK WHETHER THIS IS FIRST RUN AND DEPENDENCIES WERE ALREADY CHECKED
if [ "$INIT" -eq 1 ] || [ "$DEPCHECK" -eq 0 ]; then
  "$SCRIPTDIR/bootstrap"
fi

### disclaimers
info "${PURPLE}lantern is intended for ${RED}ETHICAL hacking only.${END} " \
  "${ORANGE}Please do not use it to break the law.${END}"
info "${PURPLE}lantern config file is at: ${BLUE}${CONFIG}${END}"

"$SCRIPTDIR/banner"			# cue banner

### let's make our output folders finally
mkdir -p "${BASEDIR}/${TARGET}"

### FINALLY, LFG!
nmap-disc || exit 2
nmap-targeted &
nmappid=$!

### time to launch service modules in parallel with targeted scan
