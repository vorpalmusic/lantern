#!/bin/bash
### lantern:
### modular and automated pen-testing enumeration and reporting tool
### author: J4CKD4W

### DO NOT RUN LANTERN AS ROOT
if [ "${EUID:-$(id -u)}" -eq 0 ]; then
  fail "Run as a normal user; lantern will ask for sudo when needed." >&2
  exit 1
fi

### Grab ROOTDIR, path variables and necessary libraries
PATHFINDER="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)/lib/pathfinder"
. "$PATHFINDER"
. "$ROOTDIR/lib/messages"
. "$ROOTDIR/lib/args"
. "$LIBDIR/priv"
. "$CONFIG"

info "${CYAN}lantern should never be run as sudo, but requires sudo for some tasks. Please authorize now.${END}"
sinit			# handle sudo only for required tasks

### Handle arguments and flags
parseargs "$@"

case "$ACTION" in
  help)    argshelp; exit 0 ;;
  version) argsversion; exit 0 ;;
  config)  nano "$CONFIG"; exit 0 ;;
  error)   fail "${RED}Error:${END} $ARGSERR" >&2; exit 2 ;;
  run)     : ;;
esac

### Resolve BASEDIR from config-defined OUTFOLDER
# OUTFOLDER defaults to "." in .config
mkdir -p -- "${OUTFOLDER:-.}" \
  || { fail "Cannot create outfolder: ${OUTFOLDER:-.}"; exit 2; }

BASEDIR="$(cd -- "${OUTFOLDER:-.}" && pwd -P)" \
  || { fail "Cannot resolve outfolder: ${OUTFOLDER:-.}"; exit 2; }

# Engagement directory is always BASEDIR/TARGET
OUTDIR="$BASEDIR/$TARGET"

# Export only the run-scoped state that executed scripts need
export ROOTDIR BASEDIR OUTDIR TARGET

### let's make our output folders finally
mkdir -p "$OUTDIR"

### now source libraries that depend on TARGET being set
. "$LIBDIR/nmapper"
. "$LIBDIR/parse/parse-nmap"
. "$LIBDIR/parse/parse-http-targ"

### CHECK WHETHER THIS IS FIRST RUN AND DEPENDENCIES WERE ALREADY CHECKED
if [ "$INIT" -eq 1 ] || [ "$DEPCHECK" -eq 0 ]; then
  "$SCRIPTDIR/bootstrap"
fi

### disclaimers
info "${PURPLE}lantern is intended for ${RED}ETHICAL hacking only.${END} " \
  "${ORANGE}Please do not use it to break the law.${END}"
info "${PURPLE}lantern config file is at: ${BLUE}${CONFIG}${END}"

"$SCRIPTDIR/banner"			# cue banner

### FINALLY, LFG!
nmap-disc || exit 2
nmap-services

### Launch early HTTP validation in parallel with targeted scan
nmap-check | "$MODDIR/http/http-validate" & checkid=$!

### Start targeted nmap based on discovery scan (chunked; streams HTTP candidates internally)
nmap-targeted & nmappid=$!

### Wait safely (only wait on real PIDs)
pids=()
[[ "${nmappid:-}" =~ ^[0-9]+$ ]] && pids+=("$nmappid")
[[ "${checkid:-}" =~ ^[0-9]+$ ]] && pids+=("$checkid")

if [ "${#pids[@]}" -gt 0 ]; then
  wait "${pids[@]}"
else
  warn "$(tab 1)" "Nothing to wait on (nmappid/checkid missing)."
fi

### Build canonical software inventory from targeted nmap
info "$(tab 1)" "${PURPLE}Parsing targeted nmap results into ${BLUE}versions.tsv${END}"
nmap-versions "$OUTDIR/nmap/targeted" "$OUTDIR/versions.tsv" \
  || warn "$(tab 2)" "versions.tsv not created from nmap (continuing)."

### If early canonical exists, update /etc/hosts then run http-master once
canon="$OUTDIR/http/canonical.tsv"
if [ -s "$canon" ]; then
  "$ROOTDIR/scripts/add-hosts" "$canon"
  "$ROOTDIR/modules/http/http-master"
else
  warn "$(tab 1)" "No canonical.tsv found; skipping http-master."
fi
